{
  "name": "code-strike",
  "version": "0.1.0",
  "description": "Team-based FPS where weapons are programmed, not purchased",
  "type": "module",
  "main": "dist/server/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp server/sandbox/worker.mjs dist/server/sandbox/worker.mjs",
    "start": "node dist/server/main.js",
    "test": "node --test dist/test/",
    "build:client": "esbuild client/index.ts --bundle --outfile=public/app.js --format=iife --target=es2020",
    "dev": "npm run build && npm run build:client && npm start"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "three": "^0.180.0",
    "wasmoon": "^1.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
